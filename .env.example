# Salin menjadi .env lalu isi. Berkas .env tidak boleh di-commit.

# ---- ArcadeDB (tanpa isi = ArcadeDB lokal di http://localhost:2480) ----
ARCADEDB_HOST=http://localhost:2480
ARCADEDB_DB=sre_test
ARCADEDB_USER=root
ARCADEDB_PASSWORD=

# ---- LLM untuk Ask the graph dan Brainstorm ----
# Groq gratis tanpa kartu kredit: https://console.groq.com/keys
GROQ_API_KEY=
# groq | openai | xai | openrouter | cerebras (kunci: OPENAI_API_KEY, XAI_API_KEY, ...)
LLM_PENYEDIA=groq
# Kosong = model bawaan penyedia (Groq: openai/gpt-oss-120b)
LLM_MODEL=

# ---- Server ----
# 127.0.0.1 = hanya komputer ini; 0.0.0.0 = bisa diakses dari luar (hosting)
SRE_HOST=127.0.0.1
SRE_PORT=8000
