# Salin menjadi .env lalu isi. Berkas .env tidak boleh di-commit.

# ---- ArcadeDB (tanpa isi = ArcadeDB lokal di http://localhost:2480) ----
ARCADEDB_HOST=http://localhost:2480
ARCADEDB_DB=sre_test
ARCADEDB_USER=root
ARCADEDB_PASSWORD=

# ---- Model bahasa untuk Ask the graph dan Brainstorm ----
# Penyedia: groq | openai | xai | openrouter | cerebras
LLM_PENYEDIA=groq
# Kunci API dari penyedia yang dipilih di atas
LLM_API_KEY=
# Kosong = model bawaan penyedia
#   groq: openai/gpt-oss-120b   openai: gpt-4o-mini   openrouter: openai/gpt-oss-120b
LLM_MODEL=
# Opsional: alamat API lain yang berformat OpenAI (/chat/completions).
# Bila diisi, LLM_PENYEDIA boleh bernama bebas dan LLM_MODEL wajib diisi.
LLM_URL=

# ---- Server ----
# 127.0.0.1 = hanya komputer ini; 0.0.0.0 = bisa diakses dari luar (hosting)
SRE_HOST=127.0.0.1
SRE_PORT=8000
